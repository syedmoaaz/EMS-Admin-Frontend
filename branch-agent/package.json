{
  "name": "ems-branch-agent",
  "version": "1.3.0",
  "description": "ADIL AGENCIES branch biometric agent — durable offline outbox for ZKTeco K50",
  "author": "ADIL AGENCIES",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "sync": "node src/cli.js",
    "dev:cli": "node src/cli.js --once",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "optionalDependencies": {
    "node-zklib": "^1.3.0",
    "zklib": "^0.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.adilagencies.emsbranchagent",
    "productName": "EMS Branch Agent",
    "copyright": "Copyright © ADIL AGENCIES",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-zklib/**/*",
      "**/node_modules/zklib/**/*"
    ],
    "forceCodeSigning": false,
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EMS Branch Agent",
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
